{
  "manifest_version": 3,
  "name": "# راهنمای میانبرهای مفید",
  "version": "1.0",
  "description": "لیست میانبرهای مفید کروم و ویندوز با قابلیت جابجایی و اولویت‌بندی",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}